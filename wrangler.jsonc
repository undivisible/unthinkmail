{
  "name": "purelymail-mcp-server",
  "type": "container",
  "main": "Dockerfile",
  "compatibility_date": "2024-03-21",
  "containers": {
    "command": ["./purelymail-mcp-server", "/data/config.json"],
    "image": "."
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "mcp-data"
    }
  ]
}
