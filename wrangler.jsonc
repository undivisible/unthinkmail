{
  "name": "unthinkmail",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "unthinkmail.undivisible.dev/*", "zone_name": "undivisible.dev" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "IMAP_SESSION",
        "class_name": "ImapSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "deleted_classes": ["McpContainer"],
      "new_sqlite_classes": ["ImapSession"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
