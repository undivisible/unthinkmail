{
  "name": "unthinkmail",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "routes": [
    { "pattern": "unthinkmail.undivisible.dev/*", "zone_name": "undivisible.dev" }
  ],
  "containers": [
    {
      "class_name": "McpContainer",
      "image": "./Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_CONTAINER",
        "class_name": "McpContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["McpContainer"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "purelymail-mcp-db",
      "database_id": "b6220534-97cb-4e2d-802a-5bd37cf901b7",
      "migrations_dir": "migrations"
    }
  ]
}
